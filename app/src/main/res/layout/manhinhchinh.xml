<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:gravity="center_vertical"
            android:maxLines="1"
            android:text="Kho giấy tờ"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnAddDocument"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Thêm giấy tờ"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_add_document"
            android:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnSyncMetadata"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đồng bộ metadata"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_sync"
            android:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnLockVault"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Khóa ứng dụng"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_lock"
            android:tint="?attr/colorPrimary" />

        <ImageButton
            android:id="@+id/btnLogout"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Đăng xuất"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_logout"
            android:tint="?attr/colorPrimary" />

    </LinearLayout>

    <TextView
        android:id="@+id/txtWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/txtDocumentCount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textSize="15sp" />

    <EditText
        android:id="@+id/edtSearchDocuments"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Tìm theo tên hoặc danh mục"
        android:imeOptions="actionSearch"
        android:inputType="text"
        android:minHeight="48dp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDocuments"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/txtEmptyState"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="Chưa có giấy tờ nào.\nHãy nhấn biểu tượng + để thêm."
            android:textAlignment="center"
            android:textSize="16sp" />

    </FrameLayout>

</LinearLayout>